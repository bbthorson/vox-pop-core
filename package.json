{
  "name": "vox-pop-core",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @vox-pop/core -w @vox-pop/shared -w @vox-pop/core-api",
    "lint": "npm run lint --workspaces --if-present",
    "start": "node apps/core-api/dist/index.js"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
