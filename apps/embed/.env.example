# apps/embed build-time env vars. Vite inlines `VITE_*` into the bundle.

# Origin of apps/core-api (Phase 4a Hono service). Anonymous calls only.
VITE_CORE_API_BASE_URL=http://localhost:8080

# Origin of apps/web — embed redirects the top frame here after upload
# so OTP completes on a same-origin handler. See ReplyDot.submitPendingEmbed.
VITE_HOST_APP_BASE_URL=http://localhost:9002
