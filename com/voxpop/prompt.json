{
    "lexicon": 1,
    "id": "com.voxpop.prompt",
    "defs": {
        "main": {
            "type": "record",
            "description": "A Vox Pop prompt record. Represents a question or topic for audience responses.",
            "key": "tid",
            "record": {
                "type": "object",
                "required": [
                    "id",
                    "authorId",
                    "title",
                    "audioUrl",
                    "createdAt"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the prompt."
                    },
                    "authorId": {
                        "type": "string",
                        "description": "The unique identifier (DID or Firebase UID) of the prompt author."
                    },
                    "title": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 500,
                        "description": "The main text content of the prompt."
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 2000,
                        "description": "Optional extended description or context for the prompt."
                    },
                    "audioUrl": {
                        "type": "string",
                        "format": "uri",
                        "description": "The URL to the high-quality audio recording of the prompt."
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "datetime",
                        "description": "The timestamp when the prompt was created."
                    },
                    "status": {
                        "type": "string",
                        "knownValues": [
                            "live",
                            "archived",
                            "deleted"
                        ],
                        "default": "live",
                        "description": "The current lifecycle status of the prompt."
                    }
                }
            }
        }
    }
}