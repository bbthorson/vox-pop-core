{
    "lexicon": 1,
    "id": "com.voxpop.audio.prompt",
    "defs": {
        "main": {
            "type": "record",
            "description": "A Vox Pop prompt — an audio question authored by a creator that listeners reply to.",
            "key": "tid",
            "record": {
                "type": "object",
                "required": ["title", "createdAt", "status"],
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300,
                        "description": "Short text of the question being asked."
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 3000,
                        "description": "Optional long-form context for the prompt."
                    },
                    "audio": {
                        "type": "blob",
                        "accept": ["audio/*"],
                        "maxSize": 104857600,
                        "description": "Recorded audio of the prompt as spoken by the author. Up to 100 MB."
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "datetime",
                        "description": "When the prompt was created (ISO 8601)."
                    },
                    "status": {
                        "type": "string",
                        "knownValues": ["live", "archived"],
                        "description": "Lifecycle state. `live` = visible and accepting replies; `archived` = visible but closed for new replies."
                    }
                }
            }
        }
    }
}
