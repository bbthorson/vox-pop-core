# Production build env vars. Vite inlines `VITE_*` into the bundle
# when `NODE_ENV=production` (i.e. `npm run build`).
#
# Checked in: these are public URLs, not secrets. Override locally
# by creating an `.env.production.local` (gitignored) if you need
# to point a prod build at different origins.

VITE_CORE_API_BASE_URL=https://api.voxpop.phonicfactory.com
# Public capture app (apps/public) — the embed redirects the top frame here to
# finish a reply on the prompt page (`/@handle/promptId`). Post apps/public split
# this is `prompts.`, not the inbox.
VITE_HOST_APP_BASE_URL=https://prompts.voxpop.phonicfactory.com
